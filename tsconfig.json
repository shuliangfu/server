{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": []
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
